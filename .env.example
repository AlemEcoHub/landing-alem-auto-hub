# Lead delivery (optional — leads are logged server-side if unset)
# Telegram: create a bot via @BotFather, get the token, and your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Any webhook (Google Sheets via Apps Script, Make.com, n8n, CRM, email service)
LEAD_WEBHOOK_URL=

# Analytics — wire these up in app/[locale]/layout.tsx <head> as needed:
# NEXT_PUBLIC_GA_ID=G-XXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_YANDEX_METRIKA_ID=
